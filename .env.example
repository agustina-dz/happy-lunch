# ============================================================
# Environment Variables — TEMPLATE
# ============================================================
# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored. Never commit your real keys.
#
# Vite exposes variables prefixed with VITE_ to client-side code at build time.
#
# Reference them via: import.meta.env.VITE_VARIABLE_NAME
# ============================================================


# ----- ImgBB ----- #
# Image upload service. Get a free API key at https://api.imgbb.com
VITE_IMGBB_API_KEY=


# ----- Firebase ----- #
# Get these values from your Firebase project:
# Firebase Console → Project Settings → General → SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=